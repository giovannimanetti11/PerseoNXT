# Values are read at build time and baked into the server bundle.
# At runtime they can be overridden with NUXT_<camelCase key in SNAKE_CASE>,
# e.g. NUXT_SENDGRID_API_KEY.

# WordPress GraphQL (public endpoint, no credentials needed)
WP_BASE_URL=https://admin.wikiherbalist.com/graphql
# Optional: overrides WP_BASE_URL, e.g. a local upstream
GRAPHQL_ENDPOINT=
# Production deploy only: absolute path supplied outside the repository
WP_CONTENT_PATH=/absolute/path/to/wordpress/wp-content

# Algolia
NUXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NUXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_api_key
ALGOLIA_WRITE_API_KEY=your_algolia_write_api_key
# Password of the /algoliaUpdate page: prefer the bcrypt hash
# (node scripts/hash-password.mjs <password>), the plain value is a fallback.
ALGOLIA_ACCESS_PASSWORD_HASH=
ALGOLIA_ACCESS_PASSWORD=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX); leave empty to disable GA
NUXT_PUBLIC_GA_ID=

# PayPal (donations page)
PAYPAL_CLIENT_ID=your_paypal_client_id

# PubMed (publication counter on monographs, optional)
PUBMED_API_KEY=

# SendGrid (contact and proposal forms)
SENDGRID_API_KEY=your_sendgrid_api_key

# reCAPTCHA v3
RECAPTCHA_PUBLIC_KEY=your_recaptcha_public_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Mailchimp (newsletter)
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_mailchimp_list_id
MAILCHIMP_SERVER_PREFIX=us17

# MySQL (feedback widget, table wh_perseo_feedback)
DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Redis cache for GBIF observations (optional)
REDIS_PASSWORD=
