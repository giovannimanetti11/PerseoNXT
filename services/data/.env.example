# PostgreSQL connection string (dedicated user, database wikiherbalist_data)
DATABASE_URL=postgres://wikiherbalist_data:CHANGE_ME@127.0.0.1:5432/wikiherbalist_data
# The API listens on localhost only
HOST=127.0.0.1
PORT=4010
# WordPress GraphQL endpoint (published plants only, anonymous)
WP_GRAPHQL_URL=https://admin.wikiherbalist.com/graphql
# Optional NCBI key: 10 requests/s instead of 3
NCBI_API_KEY=
# Bearer token for POST /v1/admin/*
ADMIN_TOKEN=
# Contact URL sent in the User-Agent, as the sources ask
CONTACT_URL=https://wikiherbalist.com
